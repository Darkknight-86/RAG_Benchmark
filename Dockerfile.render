# Render Deployment Dockerfile - RAG Benchmarking Platform
# Optimized for Render.com deployment with all microservices

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    make \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry
RUN pip install poetry

# Configure Poetry for production
RUN poetry config virtualenvs.create false
RUN poetry config installer.max-workers 10

# Copy all source code
COPY . .

# Debug: List contents to verify copy
RUN ls -la /app/
RUN ls -la /app/API_Gateway/ || echo "API_Gateway not found"
RUN ls -la /app/Embeddings/ || echo "Embeddings not found"
RUN ls -la /app/LLM/ || echo "LLM not found"

# Create necessary directories
RUN mkdir -p /app/data
RUN mkdir -p /app/API_Gateway/exports
RUN mkdir -p /tmp

# Install dependencies for all services
# API Gateway
RUN cd API_Gateway && poetry install --only main

# Embeddings Service
RUN cd Embeddings && poetry install --only main

# LLM Service
RUN cd LLM && poetry install --only main

# Expose ports for all services
EXPOSE 8502 8000 50051 50054

# Health check for the main dashboard
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8502 || exit 1

# Use the Render-specific Makefile to start all services
CMD ["make", "-f", "Makefile.render", "start"]